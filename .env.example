#PostgreSQL
POSTGRES_USER=user_aqui
POSTGRES_PASSWORD=password_aqui
POSTGRES_DB=db_aqui

#MongoDB
MONGO_INITDB_ROOT_USERNAME=user_aqui
MONGO_INITDB_ROOT_PASSWORD=password_aqui

# Bucket RUSTFS
RUSTFS_ACCESS_KEY=user_aqui
RUSTFS_SECRET_KEY=password_aqui

#JWT_SECRET
# Gere a sua no terminal com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=jwt_secret_aqui

#Modelo
# Pasta com os arquivos de um release do treino. Sem ela, a API sobe sem modelo (ver README)
MODELO_DIR=../modelo

#CORS
# Origens do front que podem chamar a API, em JSON (no deploy, a URL pública do front)
CORS_ORIGENS=["http://localhost:3000"]
